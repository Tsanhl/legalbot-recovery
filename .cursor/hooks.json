{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/factual-gap-fill.py",
        "timeout": 240
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/factual-gap-fill.py",
        "timeout": 240
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/factual-gap-fill.py",
        "timeout": 20,
        "loop_limit": 1
      }
    ]
  }
}
