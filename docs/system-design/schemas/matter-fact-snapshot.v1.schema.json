{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.legalbot.invalid/schemas/matter-fact-snapshot.v1.schema.json",
  "title": "LegalBot MatterFactSnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot_id",
    "conversation_id",
    "conversation_revision",
    "created_at",
    "facts",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "legalbot.matter-fact-snapshot.v1"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,254}$"
    },
    "conversation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,254}$"
    },
    "conversation_revision": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "facts": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://local.legalbot.invalid/schemas/matter-fact.v1.schema.json",
        "title": "Matter fact",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "fact_key",
          "data_type",
          "encrypted_value_ref",
          "value_sha256",
          "status",
          "revision",
          "created_at",
          "fact_refs"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,254}$"
          },
          "fact_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,254}$"
          },
          "data_type": {
            "enum": [
              "date",
              "datetime",
              "money",
              "integer",
              "decimal",
              "boolean",
              "text",
              "identifier",
              "location",
              "party_role"
            ]
          },
          "encrypted_value_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,254}$"
          },
          "value_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "user_stated",
              "document_extracted",
              "user_confirmed",
              "disputed",
              "unknown"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "supersedes_fact_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,254}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "conflict_group_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,254}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "fact_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://local.legalbot.invalid/schemas/fact-ref.v1.schema.json",
              "title": "Fact reference",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_kind",
                "source_id",
                "source_revision",
                "content_sha256"
              ],
              "properties": {
                "source_kind": {
                  "enum": [
                    "message",
                    "upload"
                  ]
                },
                "source_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,254}$"
                },
                "source_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "safe_locator": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 255
                }
              }
            }
          }
        }
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
