{
  "$id": "https://local.legalbot.invalid/schemas/runtime-capability-manifest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "reason_code": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_APPLICABLE"
            ]
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "name",
          "status",
          "evidence_sha256",
          "reason_code",
          "checked_at",
          "valid_until"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,254}$",
      "type": "string"
    },
    "operation_grants": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "granted": {
            "type": "boolean"
          },
          "operation": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "required_capabilities": {
            "items": {
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "decision_reason_code": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          }
        },
        "required": [
          "operation",
          "granted",
          "required_capabilities",
          "decision_reason_code"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "type": "array"
    },
    "process_role": {
      "enum": [
        "api",
        "answer_worker",
        "index_worker",
        "model_sidecar",
        "evaluation_harness"
      ]
    },
    "schema": {
      "const": "legalbot.runtime-capability-manifest.v1"
    },
    "process_instance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,254}$"
    },
    "environment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_selection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bound_artifacts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "manifest_id",
    "process_role",
    "created_at",
    "expires_at",
    "config_sha256",
    "capabilities",
    "operation_grants",
    "process_instance_id",
    "environment_sha256",
    "schema_selection_sha256",
    "bound_artifacts",
    "manifest_sha256"
  ],
  "title": "LegalBot RuntimeCapabilityManifest v1",
  "type": "object"
}
