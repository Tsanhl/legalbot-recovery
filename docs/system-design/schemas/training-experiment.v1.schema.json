{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.legalbot.invalid/schemas/training-experiment.v1.schema.json",
  "title": "LegalBot TrainingExperiment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "authorization_sha256",
    "objective_sha256",
    "training_corpus_sha256",
    "rights_review_sha256",
    "privacy_review_sha256",
    "leakage_report_sha256",
    "excluded_evaluation_manifest_sha256",
    "base_model_sha256",
    "recipe_sha256",
    "resource_policy_sha256",
    "internal_validation_sha256",
    "status",
    "output_artifact_sha256",
    "metric_report_sha256",
    "started_at",
    "completed_at",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "legalbot.training-experiment.v1"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,254}$"
    },
    "authorization_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "objective_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "training_corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rights_review_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "privacy_review_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "leakage_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "excluded_evaluation_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recipe_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resource_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "internal_validation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "planned",
        "authorized",
        "running",
        "completed",
        "failed",
        "cancelled",
        "invalid"
      ]
    },
    "output_artifact_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "metric_report_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "authorized",
              "running",
              "completed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "authorization_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "output_artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "metric_report_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
