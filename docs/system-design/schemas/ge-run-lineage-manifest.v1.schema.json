{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.legalbot.invalid/schemas/ge-run-lineage-manifest.v1.schema.json",
  "title": "LegalBot GE Run Lineage Manifest v1",
  "description": "Separates historical r1, r1 rescored under the r2 evaluator, and new r2 generated-and-scored tracks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tracks",
    "comparison_uses_specific_baseline_ids",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "legalbot.ge-run-lineage-manifest.v1"
    },
    "tracks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_r1_immutable",
        "historical_r1_rescored_under_r2_evaluator",
        "new_r2_generated_and_scored_under_r2_evaluator"
      ],
      "properties": {
        "historical_r1_immutable": {
          "$ref": "#/$defs/track"
        },
        "historical_r1_rescored_under_r2_evaluator": {
          "$ref": "#/$defs/track"
        },
        "new_r2_generated_and_scored_under_r2_evaluator": {
          "$ref": "#/$defs/track"
        }
      }
    },
    "comparison_uses_specific_baseline_ids": {
      "const": true
    },
    "do_not_label_an_intermediate_baseline_as_r1": {
      "type": "boolean"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "sha256_or_empty": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id",
        "run_id",
        "present",
        "question_pack_sha256",
        "effective_source_set_sha256",
        "retriever_config_sha256",
        "reranker_sha256",
        "prompt_sha256",
        "model_or_adapter_sha256",
        "evaluator_sha256",
        "locator_receipt_sha256",
        "result_sha256"
      ],
      "properties": {
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "present": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "question_pack_sha256": {
          "$ref": "#/$defs/sha256_or_empty"
        },
        "effective_source_set_sha256": {
          "$ref": "#/$defs/sha256_or_empty"
        },
        "retriever_config_sha256": {
          "$ref": "#/$defs/sha256_or_empty"
        },
        "reranker_sha256": {
          "$ref": "#/$defs/sha256_or_empty"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256_or_empty"
        },
        "model_or_adapter_sha256": {
          "$ref": "#/$defs/sha256_or_empty"
        },
        "evaluator_sha256": {
          "$ref": "#/$defs/sha256_or_empty"
        },
        "locator_receipt_sha256": {
          "$ref": "#/$defs/sha256_or_empty"
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256_or_empty"
        }
      }
    }
  }
}
