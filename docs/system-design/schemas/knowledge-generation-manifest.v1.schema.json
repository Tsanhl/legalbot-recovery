{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.legalbot.invalid/schemas/knowledge-generation-manifest.v1.schema.json",
  "title": "LegalBot KnowledgeGenerationManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generation_id",
    "source_manifest_sha256",
    "qualification_policy_sha256",
    "sources",
    "toolchain",
    "counts",
    "file_manifest_sha256",
    "closure_status",
    "attestations",
    "created_at",
    "sealed_at",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "legalbot.knowledge-generation-manifest.v1"
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,254}$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qualification_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_version_id",
          "bytes_sha256",
          "canonical_sha256",
          "lane",
          "jurisdiction",
          "qualification_receipt_sha256"
        ],
        "properties": {
          "source_version_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,254}$"
          },
          "bytes_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "canonical_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "lane": {
            "enum": [
              "primary_authority",
              "official_secondary",
              "scholarship",
              "teaching",
              "assessment"
            ]
          },
          "jurisdiction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "qualification_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parser_sha256",
        "ocr_sha256",
        "chunker_sha256",
        "tokenizer_sha256",
        "embedding_model_sha256",
        "lexical_config_sha256",
        "vector_schema_sha256",
        "reranker_model_sha256"
      ],
      "properties": {
        "parser_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ocr_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "chunker_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tokenizer_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "embedding_model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lexical_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "vector_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reranker_model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_versions",
        "canonical_objects",
        "chunks",
        "lexical_rows",
        "vector_rows",
        "embedding_dimensions"
      ],
      "properties": {
        "source_versions": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_objects": {
          "type": "integer",
          "minimum": 0
        },
        "chunks": {
          "type": "integer",
          "minimum": 0
        },
        "lexical_rows": {
          "type": "integer",
          "minimum": 0
        },
        "vector_rows": {
          "type": "integer",
          "minimum": 0
        },
        "embedding_dimensions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "file_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "closure_status": {
      "enum": [
        "building",
        "failed",
        "validated",
        "candidate"
      ]
    },
    "attestations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "evidence_sha256",
          "reason_code"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "evidence_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sealed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
