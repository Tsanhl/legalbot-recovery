{
  "$defs": {
    "RunStatus": {
      "enum": [
        "created",
        "queued",
        "running",
        "complete",
        "verified_limited",
        "held_for_review",
        "system_error",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "pattern": "^(?:live30|live60)-q[0-9]{2}$",
      "title": "Case Id",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "generate_once",
        "coverage_only_not_selected"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "entry_id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Entry Id",
      "type": "string"
    },
    "question_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Question Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema": {
      "const": "legalbot.live-evaluation-case-index.v2",
      "default": "legalbot.live-evaluation-case-index.v2",
      "title": "Schema",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "entry_id",
    "timestamp",
    "run_id",
    "case_id",
    "question_sha256",
    "disposition",
    "status"
  ],
  "title": "LiveSuiteCaseIndexEntry",
  "type": "object"
}
