{
  "$defs": {
    "LiveRunPlanCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^(?:live30|live60)-q[0-9]{2}$",
          "title": "Case Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "generate_once",
            "coverage_only_not_selected"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "expected_research_route": {
          "enum": [
            "sectioned",
            "full_enquiry"
          ],
          "title": "Expected Research Route",
          "type": "string"
        },
        "pass_count": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pass Count",
          "type": "integer"
        },
        "schema": {
          "const": "legalbot.live-evaluation-run-plan-case.v1",
          "default": "legalbot.live-evaluation-run-plan-case.v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "disposition",
        "pass_count",
        "expected_research_route"
      ],
      "title": "LiveRunPlanCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annexes": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "propertyNames": {
        "enum": [
          "A",
          "B",
          "C"
        ]
      },
      "title": "Annexes",
      "type": "object"
    },
    "as_of_policy": {
      "const": "run_admission_europe_london",
      "title": "As Of Policy",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/LiveRunPlanCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "cross_border_limit_case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Cross Border Limit Case Ids",
      "type": "array"
    },
    "eligible_for_training": {
      "const": false,
      "title": "Eligible For Training",
      "type": "boolean"
    },
    "essay_structure_id": {
      "const": "live60-essay-v1",
      "title": "Essay Structure Id",
      "type": "string"
    },
    "generation_case_count": {
      "const": 30,
      "title": "Generation Case Count",
      "type": "integer"
    },
    "generation_route_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "sectioned",
          "full_enquiry"
        ]
      },
      "title": "Generation Route Counts",
      "type": "object"
    },
    "generation_task_type_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "problem",
          "essay"
        ]
      },
      "title": "Generation Task Type Counts",
      "type": "object"
    },
    "generation_total_word_target": {
      "const": 114000,
      "title": "Generation Total Word Target",
      "type": "integer"
    },
    "legal_date_timezone": {
      "const": "Europe/London",
      "title": "Legal Date Timezone",
      "type": "string"
    },
    "local_only_first_run": {
      "const": true,
      "title": "Local Only First Run",
      "type": "boolean"
    },
    "model_generation_concurrency": {
      "const": 1,
      "title": "Model Generation Concurrency",
      "type": "integer"
    },
    "nonselected_disposition": {
      "const": "coverage_only_not_selected",
      "title": "Nonselected Disposition",
      "type": "string"
    },
    "online_research_allowed": {
      "const": false,
      "title": "Online Research Allowed",
      "type": "boolean"
    },
    "problem_structure_id": {
      "const": "live60-problem-v1",
      "title": "Problem Structure Id",
      "type": "string"
    },
    "purpose": {
      "const": "evaluation_only",
      "title": "Purpose",
      "type": "string"
    },
    "run_plan_id": {
      "const": "live60-single-pass-30-v1",
      "title": "Run Plan Id",
      "type": "string"
    },
    "schema": {
      "const": "legalbot.live-evaluation-run-plan.v1",
      "default": "legalbot.live-evaluation-run-plan.v1",
      "title": "Schema",
      "type": "string"
    },
    "seal_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Seal Sha256",
      "type": "string"
    },
    "stability_repeats": {
      "const": 0,
      "title": "Stability Repeats",
      "type": "integer"
    },
    "suite_id": {
      "const": "live-evaluation-60-v1",
      "title": "Suite Id",
      "type": "string"
    },
    "suite_registry_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Suite Registry Canonical Sha256",
      "type": "string"
    },
    "training_export_allowed": {
      "const": false,
      "title": "Training Export Allowed",
      "type": "boolean"
    },
    "unsupported_issue_disposition": {
      "const": "limited_or_held",
      "title": "Unsupported Issue Disposition",
      "type": "string"
    }
  },
  "required": [
    "run_plan_id",
    "suite_id",
    "suite_registry_canonical_sha256",
    "purpose",
    "eligible_for_training",
    "training_export_allowed",
    "local_only_first_run",
    "online_research_allowed",
    "model_generation_concurrency",
    "as_of_policy",
    "legal_date_timezone",
    "problem_structure_id",
    "essay_structure_id",
    "unsupported_issue_disposition",
    "nonselected_disposition",
    "cross_border_limit_case_ids",
    "stability_repeats",
    "generation_case_count",
    "generation_total_word_target",
    "generation_task_type_counts",
    "generation_route_counts",
    "cases",
    "annexes",
    "seal_sha256"
  ],
  "title": "LiveGenerationRunPlan",
  "type": "object"
}
